{
  "name": "chemstudy-app",
  "version": "0.0.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:data": "npm run build && node -e \"const fs = require('node:fs'); const file = 'dist/chemstudy-app/browser/data/elementos.json'; if (!fs.existsSync(file)) { console.error('elementos.json não foi incluído no build'); process.exit(1); } const data = JSON.parse(fs.readFileSync(file, 'utf8').replace(/^\\uFEFF/, '')); if (!Array.isArray(data) || data.length !== 118) { console.error('elementos.json inválido ou incompleto'); process.exit(1); } console.log(data.length + ' elementos disponíveis no build');\""
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.1",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/platform-browser-dynamic": "^22.2.1",
    "@angular/router": "^22.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.7.0",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.1",
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@types/jasmine": "~7.0.0",
    "jasmine-core": "~7.0.2",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.3.0",
    "typescript": "~6.0.0",
    "source-map": "^0.8.0",
    "uuid": "^14.0.2",
    "tar": "^7.5.22",
    "rimraf": "^6.1.3"
  }
}
